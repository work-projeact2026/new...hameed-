    <!-- Onboarding Screens -->
    <string name="onboarding_1_title">एक सुरक्षित स्थान यहाँ से शुरू होता है</string>
    <string name="onboarding_1_sub">छिपे हुए कैमरों का पता लगाएं, अपनी गोपनीयता की रक्षा करें और हर जगह सुरक्षित महसूस करें।</string>
    <string name="onboarding_2_title">जो छिपा है उसे खोजें</string>
    <string name="onboarding_2_sub">व्यावहारिक ऑप्टिकल और नजदीकी डिवाइस टूल के साथ अपने परिवेश का निरीक्षण करें।</string>
    <string name="onboarding_3_title">आस-पास के डिवाइस खोजें</string>
    <string name="onboarding_3_sub">उपलब्ध एंड्रॉइड स्कैनिंग सुविधाओं का उपयोग करके वाई-फ़ाई और ब्लूटूथ उपकरणों की समीक्षा करें।</string>
    <string name="onboarding_4_title">आपकी गोपनीयता महत्वपूर्ण है</string>
    <string name="onboarding_4_sub">अपने फ़ोटो, रिकॉर्डिंग और सुरक्षा घटनाओं को एक निजी वॉल्ट में सुरक्षित रखें।</string>
    
    <string name="promo_title">अधिक उपकरण। अधिक नियंत्रण।</string>
    <string name="promo_sub">उपलब्ध होने पर वैकल्पिक उन्नत सुविधाओं का अन्वेषण करें।</string>
    <string name="promo_card_title">SecureLens प्रीमियम</string>
    <string name="promo_card_desc">खरीदने से पहले योजनाओं और शर्तों की तुलना करें। इस पूर्वावलोकन से कुछ भी शुल्क नहीं लिया जाता है।</string>
